---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Page Not Found" description="The page you're looking for doesn't exist">
  <section class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center">
      <div class="mb-6">
        <span class="text-6xl md:text-8xl font-bold text-gradient">404</span>
      </div>

      <h1 class="text-lg font-semibold text-navy mb-3">
        Page Not Found
      </h1>
      <p class="text-slate text-sm mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <a
        href="/"
        class="inline-block text-sm px-6 py-2.5 bg-blue text-white hover:bg-blue-light transition-colors rounded-full"
      >
        &larr; Back to Home
      </a>
    </div>
  </section>
</Layout>
