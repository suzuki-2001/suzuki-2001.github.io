---
import Layout from '../layouts/Layout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import RetroProteinBackground from '../components/RetroProteinBackground.astro';

const profile = {
  name: "Shosuke Suzuki",
  title: "Ph.D. Student",
  affiliation: "Graduate School of Systems and Information Engineering",
  university: "University of Tsukuba",
  email: "suzuki.shosuke@kde.cs.tsukuba.ac.jp",
  orcid: "https://orcid.org/0009-0001-3354-195X",
  github: "https://github.com/suzuki-2001",
  twitter: "https://twitter.com/suzuki2001_",
  linkedin: "https://www.linkedin.com/in/suzuki2001"
};

const about = `I am a Ph.D. student in Computer Science at the University of Tsukuba. My research focuses on applying deep learning to biological sequence analysis, particularly genomic language models and protein structure prediction.`;

const researchAreas = [
  {
    title: "Protein Design",
    description: "Leveraging deep generative models and latent space manipulation for protein dynamic structure prediction and de novo binder design.",
    keywords: ["Protein", "Generative AI", "Structure"]
  },
  {
    title: "Genomic Language Models",
    description: "Developing transformer-based models for plant genome annotation and regulatory element prediction with novel k-mer tokenization strategies.",
    keywords: ["NLP", "Genomics", "Transformers"]
  }
];

const publications = [
  {
    title: "Genomic language models with k-mer tokenization strategies for plant genome annotation and regulatory element strength prediction",
    authors: "S. Suzuki, K. Horie, T. Amagasa, N. Fukuda",
    venue: "Plant Molecular Biology",
    year: "2025",
    type: "paper" as const,
    link: "https://doi.org/10.1007/s11103-025-01604-7"
  }
];

const conferences = [
  {
    title: "Pacific Symposium on Biocomputing (PSB) 2026",
    type: "Poster",
    location: "Hawaii, USA",
    date: "Jan 2026"
  },
  {
    title: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    type: "Poster / Forum",
    location: "Yokohama, Japan",
    date: "Dec 2025"
  }
];

const awards = [
  {
    title: "Protein Design Competition (NiG)",
    event: "Adaptyv Bio - Selected for Expert Review & Wet Lab Validation",
    year: "2025",
    ongoing: true,
    detail: null
  },
  {
    title: "MBSJ-EMBO Poster Award",
    event: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    year: "2025",
    ongoing: false,
    detail: "Top 3% (51 selected from 1,599 entries)"
  },
  {
    title: "8th Place, Protein Design Competition (EGFR)",
    event: "Adaptyv Bio",
    year: "2024",
    ongoing: false,
    detail: "Top 10 out of 130+ participants worldwide"
  },
  {
    title: "Japan Biology Olympiad - Excellence Award",
    event: "158th place out of 4,189 competitors",
    year: "2018",
    ongoing: false,
    detail: "Top 3%"
  }
];

const education = [
  {
    degree: "Ph.D. in Computer Science",
    school: "University of Tsukuba",
    period: "2025.04 - 2028.03 (expected)"
  },
  {
    degree: "M.S. in Agro-Bioresources Science",
    school: "University of Tsukuba",
    period: "2023.04 - 2025.03"
  },
  {
    degree: "B.S. in Agro-Biological Resource Sciences",
    school: "University of Tsukuba",
    period: "2019.04 - 2023.03"
  }
];

const funding = [
  {
    name: "JSPS DC2",
    full: "Research Fellowship for Young Scientists",
    period: "2026.04 - 2028.03"
  },
  {
    name: "JST SPRING",
    full: "Support for Pioneering Research Initiated by the Next Generation",
    period: "2025.04 - 2026.03"
  }
];

const researchAssistant = [
  {
    org: "National Institute of Advanced Industrial Science and Technology (AIST)",
    department: "Human Informatics and Interaction Research Institute",
    period: "2024.09 - Present"
  },
  {
    org: "National Institute of Genetics (NIG)",
    department: "ALIS Center, BioGenAI Research Group",
    period: "2025.04 - Present"
  },
  {
    org: "National Agriculture and Food Research Organization (NARO)",
    department: "Agro-Environmental Informatics Group",
    period: "2022.04 - 2024.08"
  }
];
---

<Layout title={`${profile.name} | Researcher`} description={`${profile.title} at ${profile.university}`}>
  <!-- Hero Section -->
  <section class="min-h-[65vh] flex items-center justify-center px-6 py-12 relative overflow-hidden">
    <RetroProteinBackground />
    <div class="max-w-4xl mx-auto text-center stagger-children relative z-10">
      <PixelAvatar />

      <div class="mt-6 mb-3">
        <h1 class="text-pixel text-lg md:text-2xl text-warm-white mb-2">
          <span id="typewriter" class="typewriter"></span><span class="cursor">_</span>
        </h1>
      </div>

      <p class="text-caramel text-lg mb-1 typewriter-fade" style="opacity: 0;">{profile.title}</p>
      <p class="text-cream/80 text-sm">{profile.affiliation}</p>
      <p class="text-cream/60 text-sm">{profile.university}</p>

    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="max-w-4xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; ABOUT</SectionTitle>

    <div class="bg-mocha-surface/50 border border-mocha-subtle/50 rounded-sm p-5">
      <p class="text-cream/90 leading-relaxed text-sm">
        {about}
      </p>
    </div>

    <!-- Info Grid -->
    <div class="grid md:grid-cols-3 gap-4 mt-4">
      <!-- Education -->
      <div class="bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-4">
        <h3 class="text-pixel text-[10px] text-caramel mb-3 tracking-wider">EDUCATION</h3>
        <div class="space-y-2">
          {education.map(edu => (
            <div class="text-sm">
              <div class="text-warm-white font-medium text-xs">{edu.degree}</div>
              <div class="text-cream/50 text-xs">{edu.school} · {edu.period}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Funding -->
      <div class="bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-4">
        <h3 class="text-pixel text-[10px] text-caramel mb-3 tracking-wider">FUNDING</h3>
        <div class="space-y-2">
          {funding.map(fund => (
            <div class="text-sm">
              <div class="text-warm-white font-medium text-xs">{fund.name}</div>
              <div class="text-cream/50 text-xs">{fund.period}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Assistant -->
      <div class="bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-4">
        <h3 class="text-pixel text-[10px] text-caramel mb-3 tracking-wider">POSITIONS</h3>
        <div class="space-y-2">
          {researchAssistant.map(ra => (
            <div class="text-sm">
              <div class="text-warm-white font-medium text-xs leading-tight">{ra.org}</div>
              <div class="text-cream/50 text-xs">{ra.period}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Section -->
  <section id="research" class="max-w-5xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; RESEARCH</SectionTitle>

    <div class="grid grid-cols-2 gap-3">
      {researchAreas.map(area => (
        <ResearchCard {...area} />
      ))}
    </div>
  </section>

  <!-- Publications Section -->
  <section id="publications" class="max-w-4xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; PUBLICATIONS</SectionTitle>

    <div class="space-y-4">
      {publications.map(pub => (
        <PublicationCard {...pub} />
      ))}
    </div>

    <div class="mt-4 text-center">
      <a
        href={profile.orcid}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-pixel text-[10px] px-4 py-2 bg-mocha-surface/50 border border-caramel/50 text-caramel hover:bg-caramel/20 hover:border-caramel transition-colors rounded-sm"
      >
        VIEW ON ORCID →
      </a>
    </div>
  </section>

  <!-- Conferences Section -->
  <section id="conferences" class="max-w-4xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; CONFERENCES</SectionTitle>

    <div class="grid sm:grid-cols-2 gap-3">
      {conferences.map(conf => (
        <div class="bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-4 card-hover">
          <div class="flex justify-between items-start gap-2 mb-1">
            <h3 class="text-warm-white font-medium text-sm leading-tight">{conf.title}</h3>
            <span class="text-pixel text-[9px] text-caramel whitespace-nowrap">{conf.date}</span>
          </div>
          <p class="text-cream/50 text-xs">{conf.type} · {conf.location}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Awards Section -->
  <section id="awards" class="max-w-4xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; AWARDS</SectionTitle>

    <div class="grid sm:grid-cols-2 gap-3">
      {awards.map(award => (
        <div class={`bg-mocha-surface/30 border rounded-sm p-4 card-hover ${award.ongoing ? 'border-pixel-green/40' : 'border-mocha-subtle/30'}`}>
          <div class="flex justify-between items-start gap-2 mb-1">
            <div class="flex items-center gap-2">
              <h3 class="text-warm-white font-medium text-sm">{award.title}</h3>
              {award.ongoing && (
                <span class="text-pixel text-[7px] px-1.5 py-0.5 bg-pixel-green/20 text-pixel-green rounded-sm">ONGOING</span>
              )}
            </div>
            <span class={`text-pixel text-[9px] ${award.ongoing ? 'text-pixel-green' : 'text-caramel'}`}>{award.year}</span>
          </div>
          <p class="text-cream/50 text-xs">{award.event}</p>
          {award.detail && (
            <p class="text-pixel text-[8px] text-caramel/80 mt-1">{award.detail}</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="max-w-4xl mx-auto px-6 py-10 animate-on-scroll">
    <SectionTitle>&gt; CONTACT</SectionTitle>

    <div class="bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-6 text-center">
      <p class="text-cream/70 text-sm mb-4">
        Open for collaborations and research discussions
      </p>

      <div class="flex justify-center gap-3 flex-wrap mb-4">
        <PixelIcon type="email" href={`mailto:${profile.email}`} label="Email" />
        <PixelIcon type="github" href={profile.github} label="GitHub" />
        <PixelIcon type="twitter" href={profile.twitter} label="Twitter" />
        <PixelIcon type="linkedin" href={profile.linkedin} label="LinkedIn" />
      </div>

      <p class="text-pixel text-[9px] text-mocha-subtle">
        {profile.email}
      </p>
    </div>
  </section>
</Layout>
