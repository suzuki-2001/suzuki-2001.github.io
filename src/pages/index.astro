---
import Layout from '../layouts/Layout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import RetroProteinBackground from '../components/RetroProteinBackground.astro';

const profile = {
  name: "Shosuke Suzuki",
  title: "Ph.D. Student",
  affiliation: "Graduate School of Systems and Information Engineering",
  university: "University of Tsukuba",
  email: "suzuki.shosuke@kde.cs.tsukuba.ac.jp",
  orcid: "https://orcid.org/0009-0001-3354-195X",
  github: "https://github.com/suzuki-2001",
  twitter: "https://twitter.com/suzuki2001_",
  linkedin: "https://www.linkedin.com/in/suzuki2001"
};

const links = {
  ariizumi: "https://sites.google.com/view/ariizumi-laboratory/home",
  kde: "https://www.kde.cs.tsukuba.ac.jp/",
  alis: "https://ds.rois.ac.jp/en_center10/"
};

const researchAreas = [
  {
    title: "Protein Dynamics & Design",
    description: "Conformational sampling in protein structure prediction models, dynamics-driven de novo binder design, and latent space manipulation for exploring protein conformational landscapes.",
    keywords: ["Conformational Sampling", "Binder Design", "Protein Dynamics", "Generative AI"]
  },
  {
    title: "Genomic Language Models",
    description: "Building and applying genomic foundation models such as Nucleotide Transformer and Evo to learn the regulatory grammar of genomes, enabling functional sequence prediction and rational genome design across organisms.",
    keywords: ["Foundation Models", "Genomics", "DNA Language Models", "Sequence Design"]
  },
  {
    title: "Deep Learning for Biology",
    description: "Applying modern deep learning techniques to diverse biological problems, bridging computational methods with experimental validation.",
    keywords: ["Deep Learning", "Bioinformatics", "Structure Prediction"]
  }
];

const publications = [
  {
    title: "ConforFlux: Particle-Guided Trunk Repulsion for Diverse Protein Conformations",
    authors: "S. Suzuki, T. Amagasa",
    venue: "bioRxiv",
    year: "2026",
    type: "preprint" as const,
    link: "https://doi.org/10.64898/2026.05.16.725138"
  },
  {
    title: "Biasing Conformational Sampling in AlphaFold 3 and Boltz-2 via Pair Representation Scaling",
    authors: "S. Suzuki, T. Amagasa",
    venue: "bioRxiv",
    year: "2026",
    type: "preprint" as const,
    link: "https://doi.org/10.64898/2026.01.23.701250"
  },
  {
    title: "Genomic language models with k-mer tokenization strategies for plant genome annotation and regulatory element strength prediction",
    authors: "S. Suzuki, K. Horie, T. Amagasa, N. Fukuda",
    venue: "Plant Molecular Biology",
    year: "2025",
    type: "paper" as const,
    link: "https://doi.org/10.1007/s11103-025-01604-7"
  }
];

type Conference = {
  title: string;
  type: string | null;
  location: string;
  date: string;
  upcoming: boolean;
  presentations: string[];
};

const conferences: Conference[] = [
  {
    title: "BMB2026 - MBSJ / JBS Joint Meeting",
    type: null,
    location: "Yokohama, Japan",
    date: "Dec 2026",
    upcoming: true,
    presentations: [
      "Generating diverse protein conformations by repulsion in the conditioning representation"
    ]
  },
  {
    title: "ICBBS 2026 - 64th Annual Meeting of the BSJ",
    type: "Poster",
    location: "Busan, Korea",
    date: "Nov 2026",
    upcoming: true,
    presentations: [
      "Surfacing the alternative conformations latent in deep-learning protein structure predictors"
    ]
  },
  {
    title: "CBI Society Annual Meeting 2026",
    type: null,
    location: "Tokyo, Japan",
    date: "Oct 2026",
    upcoming: true,
    presentations: []
  },
  {
    title: "IIBMP 2026 - JSBi Annual Meeting",
    type: "Poster / Workshop",
    location: "Sagamihara, Japan",
    date: "Aug 2026",
    upcoming: true,
    presentations: [
      "Expanding conformational sampling in diffusion-based protein structure prediction models at inference time",
      "Do genomic foundation models learn male sterility? An interpretation with sparse autoencoders"
    ]
  },
  {
    title: "The 66th Biophysics Summer School",
    type: "Hands-on / Poster",
    location: "Nagano, Japan",
    date: "Aug 2026",
    upcoming: true,
    presentations: []
  },
  {
    title: "Pacific Symposium on Biocomputing (PSB) 2026",
    type: "Poster",
    location: "Hawaii, USA",
    date: "Jan 2026",
    upcoming: false,
    presentations: [
      "Predicting alternative protein conformations by perturbing pair representations"
    ]
  },
  {
    title: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    type: "Poster / Forum",
    location: "Yokohama, Japan",
    date: "Dec 2025",
    upcoming: false,
    presentations: [
      "Steering dynamic protein structures by latent space manipulation of deep generative models"
    ]
  },
  {
    title: "The 143rd Meeting of the Japanese Society of Breeding",
    type: "Oral",
    location: "Shizuoka, Japan",
    date: "Mar 2023",
    upcoming: false,
    presentations: [
      "Development of non-destructive, high-throughput metabolite measurement for a Micro-Tom mutant population"
    ]
  }
];

const awards = [
  {
    title: "MBSJ-EMBO Poster Award",
    event: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    year: "2025",
    ongoing: false,
    detail: "Top 3% (51 selected from 1,599 entries)"
  },
  {
    title: "8th Place, Protein Design Competition (EGFR)",
    event: "Adaptyv Bio",
    year: "2024",
    ongoing: false,
    detail: "Top 10 out of 130+ participants worldwide"
  },
  {
    title: "Japan Biology Olympiad - Excellence Award",
    event: "158th place out of 4,189 competitors",
    year: "2018",
    ongoing: false,
    detail: "Top 3%"
  }
];

const education = [
  {
    degree: "Ph.D. in Computer Science",
    school: "University of Tsukuba",
    period: "2025.04 - 2028.03 (expected)"
  },
  {
    degree: "M.S. in Agro-Bioresources Science",
    school: "University of Tsukuba",
    period: "2023.04 - 2025.03"
  },
  {
    degree: "B.S. in Agro-Biological Resource Sciences",
    school: "University of Tsukuba",
    period: "2019.04 - 2023.03"
  }
];

const funding = [
  {
    name: "JSPS DC2",
    full: "日本学術振興会 特別研究員 DC2",
    fullEn: "JSPS Research Fellowship for Young Scientists (DC2)",
    period: "2026.04 - 2028.03",
    highlight: true
  },
  {
    name: "JST SPRING",
    full: "次世代研究者挑戦的研究プログラム",
    fullEn: "Support for Pioneering Research Initiated by the Next Generation",
    period: "2025.04 - 2026.03",
    highlight: false
  }
];

const computing = [
  {
    name: "Osaka Univ. D3 Center SQUID",
    detail: "世界と伍する学生育成特設枠",
    detailEn: "Special Quota for Fostering Globally Competitive Students",
    period: "2026.04 - 2027.03"
  }
];

const researchAssistant = [
  {
    org: "Research Organization of Information and Systems (ROIS)",
    department: "AI-Empowered Life Science Initiative (ALIS)",
    period: "2026.06 - Present"
  },
  {
    org: "National Institute of Advanced Industrial Science and Technology (AIST)",
    department: "Human Informatics and Interaction Research Institute",
    period: "2024.09 - 2026.03"
  },
  {
    org: "National Agriculture and Food Research Organization (NARO)",
    department: "Agro-Environmental Informatics Group",
    period: "2022.04 - 2024.08"
  }
];
---

<Layout title={`${profile.name} | Researcher`} description={`${profile.title} at ${profile.university}`}>
  <!-- Hero Section -->
  <section class="min-h-[60vh] flex items-center justify-center px-6 py-12 relative overflow-hidden bg-base-blue">
    <RetroProteinBackground />
    <div class="max-w-4xl mx-auto text-center stagger-children relative z-10">
      <PixelAvatar />

      <div class="mt-6 mb-3">
        <h1 class="text-2xl md:text-3xl font-bold text-navy mb-2">
          <span id="typewriter" class="typewriter"></span><span class="cursor">|</span>
        </h1>
      </div>

      <p class="text-blue text-lg font-medium mb-1 typewriter-fade" style="opacity: 0;">{profile.title}</p>
      <p class="text-slate text-sm">{profile.affiliation}</p>
      <p class="text-slate-light text-sm">{profile.university}</p>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="max-w-4xl mx-auto px-6 py-12 animate-on-scroll">
    <SectionTitle>About</SectionTitle>

    <div class="bg-white border border-border rounded-lg p-6 shadow-sm">
      <p class="text-slate leading-relaxed text-sm">
        I am a Ph.D. student in Computer Science at the University of Tsukuba, supervised by Toshiyuki Amagasa at the <a
        href={links.kde} target="_blank" rel="noopener noreferrer" class="hover:underline">Knowledge and Data Engineering
        Laboratory</a>, where I work on conformational sampling in deep learning models of protein structure. As an
        undergraduate I studied under Tohru Ariizumi in the <a href={links.ariizumi} target="_blank" rel="noopener noreferrer"
        class="hover:underline">Ariizumi Laboratory</a>, developing non-destructive, high-throughput metabolite
        measurement for Micro-Tom tomato mutant populations, and under Naoya Fukuda for my master's, working on genomic
        language models for plant genomes. I continue that work on genomic language models as a research assistant at
        the ROIS <a href={links.alis} target="_blank" rel="noopener noreferrer" class="hover:underline">AI-Empowered Life
        Science Initiative (ALIS)</a>.
      </p>
    </div>

    <!-- Info Grid -->
    <div class="grid md:grid-cols-3 gap-4 mt-4">
      <!-- Education -->
      <div class="bg-white border border-border rounded-lg p-5">
        <h3 class="text-xs font-semibold text-blue mb-3 tracking-wider uppercase">Education</h3>
        <div class="space-y-3">
          {education.map(edu => (
            <div class="text-sm">
              <div class="text-navy font-medium text-xs">{edu.degree}</div>
              <div class="text-slate-light text-xs">{edu.school} · {edu.period}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Funding & Computing -->
      <div class="bg-white border border-border rounded-lg p-5">
        <h3 class="text-xs font-semibold text-blue mb-3 tracking-wider uppercase">Funding & Computing</h3>
        <div class="space-y-3">
          {funding.map(fund => (
            <div class="text-sm">
              <div class="text-navy font-medium text-xs">{fund.name}</div>
              {fund.highlight ? (
                <div class="text-gold text-xs font-medium">{fund.full}</div>
              ) : (
                <div class="text-slate text-xs">{fund.full}</div>
              )}
              <div class="text-slate-light text-[11px] leading-snug">{fund.fullEn}</div>
              <div class="text-slate-light text-xs">{fund.period}</div>
            </div>
          ))}
          {computing.map(comp => (
            <div class="text-sm">
              <div class="text-navy font-medium text-xs">{comp.name}</div>
              <div class="text-gold text-xs font-medium">{comp.detail}</div>
              <div class="text-slate-light text-[11px] leading-snug">{comp.detailEn}</div>
              <div class="text-slate-light text-xs">{comp.period}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Positions -->
      <div class="bg-white border border-border rounded-lg p-5">
        <h3 class="text-xs font-semibold text-blue mb-3 tracking-wider uppercase">Research Assistant</h3>
        <div class="space-y-3">
          {researchAssistant.map(ra => (
            <div class="text-sm">
              <div class="text-navy font-medium text-xs leading-tight">{ra.org}</div>
              {ra.department && <div class="text-slate text-xs leading-tight">{ra.department}</div>}
              {ra.period && <div class="text-slate-light text-xs">{ra.period}</div>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Section -->
  <section id="research" class="py-12 animate-on-scroll bg-base-alt">
    <div class="max-w-5xl mx-auto px-6">
      <SectionTitle>Research</SectionTitle>

      <div class="grid md:grid-cols-3 gap-4">
        {researchAreas.map(area => (
          <ResearchCard {...area} />
        ))}
      </div>
    </div>
  </section>

  <!-- Publications Section -->
  <section id="publications" class="max-w-4xl mx-auto px-6 py-12 animate-on-scroll">
    <SectionTitle>Publications</SectionTitle>

    <div class="space-y-4">
      {publications.map(pub => (
        <PublicationCard {...pub} />
      ))}
    </div>

    <div class="mt-6 text-center">
      <a
        href={profile.orcid}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-sm px-5 py-2 bg-white border border-blue/30 text-blue hover:bg-blue hover:text-white transition-colors rounded-full"
      >
        View on ORCID &rarr;
      </a>
    </div>
  </section>

  <!-- Conferences Section -->
  <section id="conferences" class="py-12 animate-on-scroll bg-base-alt">
    <div class="max-w-4xl mx-auto px-6">
      <SectionTitle>Conferences</SectionTitle>

      <div class="grid sm:grid-cols-2 gap-4">
        {conferences.map(conf => (
          <div class={`bg-white border rounded-lg p-5 card-hover ${conf.upcoming ? 'border-green/40' : 'border-border'}`}>
            <div class="flex justify-between items-start gap-2 mb-1">
              <h3 class="text-navy font-medium text-sm leading-tight">{conf.title}</h3>
              <span class={`text-xs font-medium whitespace-nowrap ${conf.upcoming ? 'text-green' : 'text-blue'}`}>{conf.date}</span>
            </div>
            <p class="text-slate-light text-xs">{conf.type ? `${conf.type} · ${conf.location}` : conf.location}</p>
            {conf.presentations.length > 0 && (
              <details class="mt-2">
                <summary class="conf-toggle text-xs text-blue cursor-pointer select-none hover:underline">
                  {conf.presentations.length === 1 ? '1 presentation' : `${conf.presentations.length} presentations`}
                </summary>
                <ul class="mt-2 space-y-1.5 pl-4 list-disc marker:text-blue/40">
                  {conf.presentations.map(p => (
                    <li class="text-slate text-xs leading-snug">{p}</li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Awards Section -->
  <section id="awards" class="max-w-4xl mx-auto px-6 py-12 animate-on-scroll">
    <SectionTitle>Awards</SectionTitle>

    <div class="grid sm:grid-cols-2 gap-4">
      {awards.map(award => (
        <div class={`bg-white border rounded-lg p-5 card-hover ${award.ongoing ? 'border-green/40' : 'border-border'}`}>
          <div class="flex justify-between items-start gap-2 mb-1">
            <div class="flex items-center gap-2">
              <h3 class="text-navy font-medium text-sm">{award.title}</h3>
              {award.ongoing && (
                <span class="text-[10px] font-semibold px-2 py-0.5 bg-green/10 text-green rounded-full">ONGOING</span>
              )}
            </div>
            <span class={`text-xs font-medium ${award.ongoing ? 'text-green' : 'text-blue'}`}>{award.year}</span>
          </div>
          <p class="text-slate-light text-xs">{award.event}</p>
          {award.detail && (
            <p class="text-xs text-gold font-medium mt-1">{award.detail}</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-12 animate-on-scroll bg-base-alt">
    <div class="max-w-4xl mx-auto px-6">
      <SectionTitle>Contact</SectionTitle>

      <div class="bg-white border border-border rounded-lg p-8 text-center shadow-sm">
        <p class="text-slate text-sm mb-5">
          Open for collaborations and research discussions
        </p>

        <div class="flex justify-center gap-3 flex-wrap mb-5">
          <PixelIcon type="email" href={`mailto:${profile.email}`} label="Email" />
          <PixelIcon type="github" href={profile.github} label="GitHub" />
          <PixelIcon type="twitter" href={profile.twitter} label="Twitter" />
          <PixelIcon type="linkedin" href={profile.linkedin} label="LinkedIn" />
        </div>

        <p class="text-xs text-slate-light">
          {profile.email}
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .conf-toggle {
    list-style: none;
  }

  .conf-toggle::-webkit-details-marker {
    display: none;
  }

  .conf-toggle::before {
    content: '\25b8';
    display: inline-block;
    margin-right: 0.35em;
    transition: transform 0.15s ease;
  }

  details[open] > .conf-toggle::before {
    transform: rotate(90deg);
  }
</style>
