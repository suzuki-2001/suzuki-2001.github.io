---
import Layout from '../layouts/Layout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProteinViewer3D from '../components/ProteinViewer3D.astro';

const profile = {
  name: "Shosuke Suzuki",
  title: "Ph.D. Student",
  affiliation: "Graduate School of Systems and Information Engineering",
  university: "University of Tsukuba",
  email: "suzuki.shosuke@kde.cs.tsukuba.ac.jp",
  orcid: "https://orcid.org/0009-0001-3354-195X",
  github: "https://github.com/suzuki-2001",
  twitter: "https://twitter.com/suzuki2001_",
  linkedin: "https://www.linkedin.com/in/suzuki2001"
};

const about = `I am a Ph.D. student in Computer Science at the University of Tsukuba. My research focuses on applying deep learning to biological sequence analysis, particularly genomic language models and protein structure prediction.`;

const researchAreas = [
  {
    title: "Genomic Language Models",
    description: "Developing transformer-based models for plant genome annotation and regulatory element prediction with novel k-mer tokenization strategies.",
    keywords: ["NLP", "Genomics", "Transformers"]
  },
  {
    title: "Protein Design",
    description: "Leveraging deep generative models and latent space manipulation for protein dynamic structure prediction and de novo binder design.",
    keywords: ["Protein", "Generative AI", "Structure"]
  },
  {
    title: "Bioinformatics",
    description: "Computational analysis of biological data, integrating machine learning approaches with molecular biology insights.",
    keywords: ["ML", "Biology", "Data Science"]
  }
];

const publications = [
  {
    title: "Genomic language models with k-mer tokenization strategies for plant genome annotation and regulatory element strength prediction",
    authors: "S. Suzuki, K. Horie, T. Amagasa, N. Fukuda",
    venue: "Plant Molecular Biology",
    year: "2025",
    type: "paper" as const,
    link: "https://doi.org/10.1007/s11103-025-01604-7"
  }
];

const conferences = [
  {
    title: "Pacific Symposium on Biocomputing (PSB) 2026",
    type: "Poster",
    location: "Hawaii, USA",
    date: "Jan 2026"
  },
  {
    title: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    type: "Poster / Forum",
    location: "Yokohama, Japan",
    date: "Dec 2025"
  }
];

const awards = [
  {
    title: "Protein Design Competition (NiG)",
    event: "Adaptyv Bio - Selected for Expert Review & Wet Lab Validation",
    year: "2025",
    ongoing: true,
    detail: null
  },
  {
    title: "MBSJ-EMBO Poster Award",
    event: "The 48th Annual Meeting of the Molecular Biology Society of Japan",
    year: "2025",
    ongoing: false,
    detail: "Top 3% (51 selected from 1,599 entries)"
  },
  {
    title: "8th Place, Protein Design Competition (EGFR)",
    event: "Adaptyv Bio",
    year: "2024",
    ongoing: false,
    detail: "Top 10 out of 130+ participants worldwide"
  },
  {
    title: "Japan Biology Olympiad - Excellence Award",
    event: "158th place out of 4,189 competitors",
    year: "2018",
    ongoing: false,
    detail: "Top 3%"
  }
];

const education = [
  {
    degree: "Ph.D. in Computer Science",
    school: "University of Tsukuba",
    period: "2025.04 - 2028.03 (expected)"
  },
  {
    degree: "M.S. in Agro-Bioresources Science",
    school: "University of Tsukuba",
    period: "2023.04 - 2025.03"
  },
  {
    degree: "B.S. in Agro-Biological Resource Sciences",
    school: "University of Tsukuba",
    period: "2019.04 - 2023.03"
  }
];

const funding = [
  {
    name: "JSPS DC2",
    full: "Research Fellowship for Young Scientists",
    period: "2026.04 - 2028.03"
  },
  {
    name: "JST SPRING",
    full: "Support for Pioneering Research Initiated by the Next Generation",
    period: "2025.04 - 2026.03"
  }
];

const researchAssistant = [
  {
    org: "National Institute of Advanced Industrial Science and Technology (AIST)",
    department: "Human Informatics and Interaction Research Institute",
    period: "2024.09 - Present"
  },
  {
    org: "National Institute of Genetics (NIG)",
    department: "ALIS Center, BioGenAI Research Group",
    period: "2025.04 - Present"
  },
  {
    org: "National Agriculture and Food Research Organization (NARO)",
    department: "Agro-Environmental Informatics Group",
    period: "2022.04 - 2024.08"
  }
];
---

<Layout title={`${profile.name} | Researcher`} description={`${profile.title} at ${profile.university}`}>
  <!-- Hero Section -->
  <section class="min-h-[80vh] flex items-center justify-center px-6 py-20 relative">
    <ProteinViewer3D />
    <div class="max-w-4xl mx-auto text-center stagger-children relative z-10">
      <PixelAvatar />

      <div class="mt-8 mb-4">
        <h1 class="text-pixel text-lg md:text-2xl text-warm-white mb-2">
          <span id="typewriter" class="typewriter"></span><span class="cursor">_</span>
        </h1>
      </div>

      <p class="text-caramel text-lg mb-2 typewriter-fade" style="opacity: 0;">{profile.title}</p>
      <p class="text-cream/80">{profile.affiliation}</p>
      <p class="text-cream/60">{profile.university}</p>

      <!-- Scroll indicator -->
      <div class="mt-16 animate-bounce">
        <span class="text-pixel text-xs text-mocha-subtle">[ scroll ]</span>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="max-w-4xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; ABOUT</SectionTitle>

    <div class="bg-mocha-surface border-4 border-mocha-subtle p-6 md:p-8">
      <p class="text-cream/90 leading-relaxed whitespace-pre-line">
        {about}
      </p>

      <!-- Education -->
      <div class="mt-8 pt-8 border-t border-mocha-subtle">
        <h3 class="text-pixel text-xs text-caramel mb-4">EDUCATION</h3>
        <div class="space-y-3">
          {education.map(edu => (
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
              <div>
                <span class="text-warm-white font-medium">{edu.degree}</span>
                <span class="text-cream/60 text-sm ml-2">@ {edu.school}</span>
              </div>
              <span class="text-pixel text-[10px] text-mocha-subtle">{edu.period}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Funding -->
      <div class="mt-8 pt-8 border-t border-mocha-subtle">
        <h3 class="text-pixel text-xs text-caramel mb-4">FUNDING</h3>
        <div class="space-y-3">
          {funding.map(fund => (
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
              <div>
                <span class="text-warm-white font-medium">{fund.name}</span>
                <span class="text-cream/60 text-sm ml-2">- {fund.full}</span>
              </div>
              <span class="text-pixel text-[10px] text-mocha-subtle">{fund.period}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Assistant -->
      <div class="mt-8 pt-8 border-t border-mocha-subtle">
        <h3 class="text-pixel text-xs text-caramel mb-4">RESEARCH ASSISTANT</h3>
        <div class="space-y-4">
          {researchAssistant.map(ra => (
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
              <div>
                <span class="text-warm-white font-medium">{ra.org}</span>
                <span class="text-cream/60 text-sm block">{ra.department}</span>
              </div>
              <span class="text-pixel text-[10px] text-mocha-subtle whitespace-nowrap">{ra.period}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Section -->
  <section id="research" class="max-w-5xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; RESEARCH</SectionTitle>

    <div class="grid md:grid-cols-3 gap-6">
      {researchAreas.map(area => (
        <ResearchCard {...area} />
      ))}
    </div>
  </section>

  <!-- Publications Section -->
  <section id="publications" class="max-w-4xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; PUBLICATIONS</SectionTitle>

    <div class="space-y-4">
      {publications.map(pub => (
        <PublicationCard {...pub} />
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href={profile.orcid}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-pixel text-xs px-6 py-3 bg-mocha-surface border-4 border-caramel text-caramel hover:bg-caramel hover:text-mocha-base transition-colors pixel-hover"
      >
        VIEW ON ORCID
      </a>
    </div>
  </section>

  <!-- Conferences Section -->
  <section id="conferences" class="max-w-4xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; CONFERENCES</SectionTitle>

    <div class="space-y-4">
      {conferences.map(conf => (
        <div class="bg-mocha-surface border-l-4 border-mocha-subtle p-6 hover:border-caramel transition-colors">
          <div class="flex flex-col sm:flex-row sm:justify-between gap-2 mb-2">
            <h3 class="text-warm-white font-semibold">{conf.title}</h3>
            <span class="text-pixel text-[10px] text-caramel">{conf.date}</span>
          </div>
          <p class="text-cream/60 text-sm">{conf.type} / {conf.location}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Awards Section -->
  <section id="awards" class="max-w-4xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; AWARDS</SectionTitle>

    <div class="space-y-4">
      {awards.map(award => (
        <div class={`group bg-mocha-surface border-l-4 p-6 hover:border-caramel transition-colors ${award.ongoing ? 'border-pixel-green' : 'border-pixel-orange'}`}>
          <div class="flex flex-col sm:flex-row sm:justify-between gap-2 mb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-warm-white font-semibold">{award.title}</h3>
              {award.ongoing && (
                <span class="text-pixel text-[8px] px-2 py-0.5 bg-pixel-green text-mocha-base">ONGOING</span>
              )}
            </div>
            <span class={`text-pixel text-[10px] ${award.ongoing ? 'text-pixel-green' : 'text-pixel-orange'}`}>{award.year}</span>
          </div>
          <p class="text-cream/60 text-sm">{award.event}</p>
          {award.detail && (
            <p class="text-pixel text-[9px] text-caramel mt-2">{award.detail}</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="max-w-4xl mx-auto px-6 py-16 animate-on-scroll">
    <SectionTitle>&gt; CONTACT</SectionTitle>

    <div class="text-center">
      <p class="text-cream/80 mb-8">
        Feel free to reach out for collaborations, questions, or just to say hello!
      </p>

      <div class="flex justify-center gap-4 flex-wrap">
        <PixelIcon type="email" href={`mailto:${profile.email}`} label="Email" />
        <PixelIcon type="github" href={profile.github} label="GitHub" />
        <PixelIcon type="twitter" href={profile.twitter} label="Twitter" />
        <PixelIcon type="linkedin" href={profile.linkedin} label="LinkedIn" />
      </div>

      <p class="text-pixel text-[10px] text-mocha-subtle mt-8">
        {profile.email}
      </p>
    </div>
  </section>
</Layout>
