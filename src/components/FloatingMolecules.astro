---
// Floating pixel-art molecules for hero background
// DNA helix, protein structures, chromatin, RNA polymerase
---

<div class="floating-molecules" aria-hidden="true">
  <!-- DNA Double Helix - Larger -->
  <svg class="molecule molecule-dna" viewBox="0 0 64 120" fill="none">
    <!-- Left strand -->
    <rect x="8" y="0" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="14" y="12" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="20" y="24" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="14" y="36" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="8" y="48" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="14" y="60" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="20" y="72" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="14" y="84" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="8" y="96" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="14" y="108" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <!-- Right strand -->
    <rect x="50" y="0" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="44" y="12" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="38" y="24" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="44" y="36" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="50" y="48" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="44" y="60" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="38" y="72" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="44" y="84" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="50" y="96" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="44" y="108" width="6" height="6" fill="currentColor" opacity="0.7"/>
    <!-- Base pairs -->
    <rect x="20" y="2" width="24" height="3" fill="currentColor" opacity="0.4"/>
    <rect x="26" y="26" width="12" height="3" fill="currentColor" opacity="0.4"/>
    <rect x="20" y="50" width="24" height="3" fill="currentColor" opacity="0.4"/>
    <rect x="26" y="74" width="12" height="3" fill="currentColor" opacity="0.4"/>
    <rect x="20" y="98" width="24" height="3" fill="currentColor" opacity="0.4"/>
  </svg>

  <!-- Folded Protein / Globular protein -->
  <svg class="molecule molecule-protein" viewBox="0 0 56 56" fill="none">
    <!-- Main globular shape -->
    <rect x="18" y="4" width="20" height="6" fill="currentColor" opacity="0.5"/>
    <rect x="10" y="10" width="36" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="6" y="16" width="44" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="4" y="22" width="48" height="8" fill="currentColor" opacity="0.8"/>
    <rect x="6" y="30" width="44" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="10" y="36" width="36" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="18" y="42" width="20" height="6" fill="currentColor" opacity="0.5"/>
    <!-- Active site highlight -->
    <rect x="20" y="20" width="16" height="12" fill="var(--color-pixel-green)" opacity="0.4"/>
    <rect x="24" y="24" width="8" height="6" fill="var(--color-pixel-green)" opacity="0.6"/>
  </svg>

  <!-- Chromatin - DNA wrapped around histones -->
  <svg class="molecule molecule-chromatin" viewBox="0 0 80 56" fill="none">
    <!-- Histone 1 -->
    <rect x="4" y="16" width="16" height="16" fill="currentColor" opacity="0.6"/>
    <rect x="8" y="20" width="8" height="8" fill="currentColor" opacity="0.8"/>
    <!-- DNA wrapping histone 1 -->
    <rect x="0" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="6" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="14" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="20" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="20" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="14" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="6" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="0" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>

    <!-- Linker DNA -->
    <rect x="24" y="22" width="8" height="3" fill="var(--color-caramel)" opacity="0.4"/>

    <!-- Histone 2 -->
    <rect x="32" y="16" width="16" height="16" fill="currentColor" opacity="0.6"/>
    <rect x="36" y="20" width="8" height="8" fill="currentColor" opacity="0.8"/>
    <!-- DNA wrapping histone 2 -->
    <rect x="28" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="34" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="42" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="48" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="48" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="42" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="34" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="28" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>

    <!-- Linker DNA -->
    <rect x="52" y="22" width="8" height="3" fill="var(--color-caramel)" opacity="0.4"/>

    <!-- Histone 3 -->
    <rect x="60" y="16" width="16" height="16" fill="currentColor" opacity="0.6"/>
    <rect x="64" y="20" width="8" height="8" fill="currentColor" opacity="0.8"/>
    <!-- DNA wrapping histone 3 -->
    <rect x="56" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="62" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="70" y="8" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="76" y="12" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="76" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="70" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="62" y="36" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
    <rect x="56" y="32" width="4" height="4" fill="var(--color-caramel)" opacity="0.5"/>
  </svg>

  <!-- RNA Polymerase - transcribing DNA -->
  <svg class="molecule molecule-rnap" viewBox="0 0 72 64" fill="none">
    <!-- DNA template (horizontal) -->
    <rect x="0" y="28" width="72" height="4" fill="var(--color-caramel)" opacity="0.4"/>
    <rect x="0" y="36" width="72" height="4" fill="var(--color-caramel)" opacity="0.4"/>

    <!-- RNAP body (sitting on DNA) -->
    <rect x="24" y="12" width="24" height="8" fill="currentColor" opacity="0.5"/>
    <rect x="20" y="20" width="32" height="8" fill="currentColor" opacity="0.7"/>
    <rect x="18" y="28" width="36" height="12" fill="currentColor" opacity="0.8"/>
    <rect x="24" y="40" width="24" height="6" fill="currentColor" opacity="0.6"/>

    <!-- Clamp -->
    <rect x="28" y="8" width="16" height="4" fill="currentColor" opacity="0.6"/>

    <!-- Active site (green glow) -->
    <rect x="32" y="28" width="8" height="8" fill="var(--color-pixel-green)" opacity="0.5"/>

    <!-- Emerging RNA transcript -->
    <rect x="54" y="20" width="4" height="4" fill="var(--color-pixel-orange)" opacity="0.6"/>
    <rect x="58" y="16" width="4" height="4" fill="var(--color-pixel-orange)" opacity="0.5"/>
    <rect x="62" y="12" width="4" height="4" fill="var(--color-pixel-orange)" opacity="0.4"/>
    <rect x="66" y="8" width="4" height="4" fill="var(--color-pixel-orange)" opacity="0.3"/>
  </svg>

  <!-- Alpha Helix - Coil -->
  <svg class="molecule molecule-helix" viewBox="0 0 48 64" fill="none">
    <!-- Coil segments with depth -->
    <rect x="6" y="0" width="10" height="6" fill="currentColor" opacity="0.4"/>
    <rect x="16" y="4" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="30" y="8" width="10" height="6" fill="currentColor" opacity="0.8"/>

    <rect x="26" y="14" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="12" y="18" width="14" height="6" fill="currentColor" opacity="0.4"/>
    <rect x="2" y="22" width="10" height="6" fill="currentColor" opacity="0.3"/>

    <rect x="6" y="28" width="10" height="6" fill="currentColor" opacity="0.4"/>
    <rect x="16" y="32" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="30" y="36" width="10" height="6" fill="currentColor" opacity="0.8"/>

    <rect x="26" y="42" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="12" y="46" width="14" height="6" fill="currentColor" opacity="0.4"/>
    <rect x="2" y="50" width="10" height="6" fill="currentColor" opacity="0.3"/>

    <rect x="6" y="56" width="10" height="6" fill="currentColor" opacity="0.4"/>
  </svg>

  <!-- Beta Sheet - Arrow ribbons -->
  <svg class="molecule molecule-beta" viewBox="0 0 64 48" fill="none">
    <!-- Strand 1 (down arrow) -->
    <rect x="4" y="0" width="6" height="30" fill="currentColor" opacity="0.6"/>
    <rect x="0" y="30" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="4" y="36" width="6" height="6" fill="currentColor" opacity="0.6"/>

    <!-- Strand 2 (up arrow) -->
    <rect x="20" y="12" width="6" height="30" fill="currentColor" opacity="0.7"/>
    <rect x="16" y="6" width="14" height="6" fill="currentColor" opacity="0.7"/>
    <rect x="20" y="0" width="6" height="6" fill="currentColor" opacity="0.7"/>

    <!-- Strand 3 (down arrow) -->
    <rect x="36" y="0" width="6" height="30" fill="currentColor" opacity="0.6"/>
    <rect x="32" y="30" width="14" height="6" fill="currentColor" opacity="0.6"/>
    <rect x="36" y="36" width="6" height="6" fill="currentColor" opacity="0.6"/>

    <!-- Strand 4 (up arrow) -->
    <rect x="52" y="12" width="6" height="30" fill="currentColor" opacity="0.5"/>
    <rect x="48" y="6" width="14" height="6" fill="currentColor" opacity="0.5"/>
    <rect x="52" y="0" width="6" height="6" fill="currentColor" opacity="0.5"/>

    <!-- Connecting loops -->
    <rect x="10" y="42" width="14" height="3" fill="currentColor" opacity="0.3"/>
    <rect x="26" y="0" width="10" height="3" fill="currentColor" opacity="0.3"/>
    <rect x="42" y="42" width="14" height="3" fill="currentColor" opacity="0.3"/>
  </svg>

  <!-- Small floating elements -->
  <div class="atom atom-1"></div>
  <div class="atom atom-2"></div>
  <div class="atom atom-3"></div>
  <div class="atom atom-4"></div>
</div>

<style>
  .floating-molecules {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .molecule {
    position: absolute;
    color: var(--color-caramel);
    opacity: 0.2;
  }

  .molecule-dna {
    width: 52px;
    height: 96px;
    top: 5%;
    left: 8%;
    animation: float-slow 20s ease-in-out infinite;
  }

  .molecule-protein {
    width: 48px;
    height: 48px;
    top: 12%;
    right: 12%;
    color: var(--color-pixel-green);
    animation: float-slow 22s ease-in-out infinite;
    animation-delay: -5s;
  }

  .molecule-chromatin {
    width: 72px;
    height: 50px;
    top: 55%;
    right: 6%;
    color: var(--color-pixel-orange);
    animation: float-slow 26s ease-in-out infinite;
    animation-delay: -3s;
  }

  .molecule-rnap {
    width: 64px;
    height: 56px;
    bottom: 8%;
    left: 10%;
    color: var(--color-cream);
    animation: float-slow 24s ease-in-out infinite reverse;
    animation-delay: -10s;
  }

  .molecule-helix {
    width: 40px;
    height: 54px;
    top: 42%;
    left: 6%;
    color: var(--color-pixel-orange);
    animation: float-slow 18s ease-in-out infinite reverse;
  }

  .molecule-beta {
    width: 56px;
    height: 42px;
    bottom: 25%;
    right: 10%;
    color: var(--color-caramel);
    animation: float-slow 24s ease-in-out infinite;
    animation-delay: -8s;
  }

  .atom {
    position: absolute;
    background: var(--color-caramel);
    opacity: 0.25;
  }

  .atom-1 {
    width: 8px;
    height: 8px;
    top: 28%;
    right: 22%;
    animation: float-atom 15s ease-in-out infinite;
  }

  .atom-2 {
    width: 6px;
    height: 6px;
    top: 75%;
    left: 22%;
    background: var(--color-pixel-orange);
    animation: float-atom 12s ease-in-out infinite reverse;
  }

  .atom-3 {
    width: 10px;
    height: 10px;
    top: 35%;
    right: 8%;
    background: var(--color-pixel-green);
    animation: float-atom 18s ease-in-out infinite;
    animation-delay: -3s;
  }

  .atom-4 {
    width: 6px;
    height: 6px;
    bottom: 40%;
    left: 18%;
    background: var(--color-pixel-orange);
    animation: float-atom 16s ease-in-out infinite reverse;
    animation-delay: -2s;
  }

  @keyframes float-slow {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-12px) rotate(1deg);
    }
    50% {
      transform: translateY(-4px) rotate(-0.5deg);
    }
    75% {
      transform: translateY(-16px) rotate(0.5deg);
    }
  }

  @keyframes float-atom {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.25;
    }
    33% {
      transform: translate(8px, -12px);
      opacity: 0.35;
    }
    66% {
      transform: translate(-4px, -8px);
      opacity: 0.2;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .molecule-beta,
    .molecule-chromatin,
    .atom-3,
    .atom-4 {
      display: none;
    }

    .molecule-dna {
      left: 4%;
      top: 8%;
      width: 44px;
      height: 84px;
    }

    .molecule-helix {
      left: 3%;
      top: 45%;
      width: 32px;
      height: 44px;
    }

    .molecule-protein {
      right: 5%;
      top: 15%;
      width: 36px;
      height: 36px;
    }

    .molecule-rnap {
      right: 4%;
      bottom: 12%;
      left: auto;
      width: 50px;
      height: 44px;
    }

    .molecule {
      opacity: 0.15;
    }
  }
</style>
