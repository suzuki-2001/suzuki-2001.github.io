---
const base = import.meta.env.BASE_URL;
---

<div class="avatar-container relative inline-block">
  <div class="w-36 h-36 md:w-40 md:h-40 mx-auto relative rounded-full overflow-hidden ring-3 ring-gold/60 ring-offset-2 ring-offset-white shadow-lg">
    <img
      src={`${base}avatar.jpg`}
      alt="Shosuke Suzuki"
      class="w-full h-full object-cover"
      loading="eager"
    />
  </div>
</div>

<style>
  .avatar-container {
    transition: transform 0.3s ease;
  }

  .avatar-container:hover {
    transform: translateY(-2px);
  }
</style>
