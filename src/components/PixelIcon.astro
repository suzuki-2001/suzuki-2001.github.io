---
interface Props {
  type: 'github' | 'twitter' | 'email' | 'scholar' | 'linkedin';
  href: string;
  label: string;
}

const { type, href, label } = Astro.props;

const icons = {
  github: `
    <rect x="3" y="2" width="10" height="10" fill="var(--color-mocha-subtle)"/>
    <rect x="4" y="3" width="8" height="8" fill="currentColor"/>
    <rect x="5" y="5" width="2" height="2" fill="var(--color-mocha-base)"/>
    <rect x="9" y="5" width="2" height="2" fill="var(--color-mocha-base)"/>
    <rect x="6" y="8" width="4" height="1" fill="var(--color-mocha-base)"/>
    <rect x="4" y="11" width="2" height="2" fill="currentColor"/>
  `,
  twitter: `
    <rect x="2" y="4" width="12" height="8" fill="currentColor"/>
    <rect x="3" y="3" width="10" height="1" fill="currentColor"/>
    <rect x="13" y="5" width="1" height="3" fill="currentColor"/>
    <rect x="4" y="6" width="8" height="1" fill="var(--color-mocha-base)"/>
    <rect x="5" y="8" width="6" height="1" fill="var(--color-mocha-base)"/>
  `,
  email: `
    <rect x="2" y="4" width="12" height="8" fill="currentColor"/>
    <rect x="3" y="4" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="12" y="4" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="4" y="5" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="11" y="5" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="5" y="6" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="10" y="6" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="6" y="7" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="9" y="7" width="1" height="1" fill="var(--color-mocha-base)"/>
    <rect x="7" y="8" width="2" height="1" fill="var(--color-mocha-base)"/>
  `,
  scholar: `
    <rect x="4" y="2" width="8" height="2" fill="currentColor"/>
    <rect x="3" y="4" width="10" height="1" fill="currentColor"/>
    <rect x="5" y="5" width="6" height="1" fill="currentColor"/>
    <rect x="6" y="6" width="4" height="1" fill="currentColor"/>
    <rect x="7" y="7" width="2" height="4" fill="currentColor"/>
    <rect x="5" y="11" width="6" height="2" fill="currentColor"/>
  `,
  linkedin: `
    <rect x="2" y="2" width="12" height="12" fill="currentColor"/>
    <rect x="4" y="5" width="2" height="7" fill="var(--color-mocha-base)"/>
    <rect x="4" y="3" width="2" height="2" fill="var(--color-mocha-base)"/>
    <rect x="7" y="5" width="2" height="1" fill="var(--color-mocha-base)"/>
    <rect x="7" y="6" width="5" height="1" fill="var(--color-mocha-base)"/>
    <rect x="10" y="7" width="2" height="5" fill="var(--color-mocha-base)"/>
    <rect x="7" y="9" width="2" height="3" fill="var(--color-mocha-base)"/>
  `
};
---

<a
  href={href}
  target={type !== 'email' ? '_blank' : undefined}
  rel={type !== 'email' ? 'noopener noreferrer' : undefined}
  aria-label={label}
  class="group inline-block p-3 bg-mocha-surface border-4 border-mocha-subtle hover:border-caramel transition-all duration-100 pixel-hover"
>
  <svg
    viewBox="0 0 16 16"
    class="w-8 h-8 text-warm-white group-hover:text-caramel transition-colors"
    style="image-rendering: pixelated;"
    set:html={icons[type]}
  />
</a>
