---
interface Props {
  title: string;
  description: string;
  keywords: string[];
}

const { title, description, keywords } = Astro.props;
---

<div class="research-card group bg-mocha-surface/30 p-4 border border-mocha-subtle/30 rounded-sm card-hover">
  <!-- Title with pixel icon -->
  <div class="flex items-center gap-2 mb-2">
    <div class="pixel-icon w-2 h-2 bg-caramel/70 rounded-sm"></div>
    <h3 class="text-sm font-semibold text-warm-white">{title}</h3>
  </div>

  <!-- Description -->
  <p class="text-xs text-cream/70 mb-3 leading-relaxed">{description}</p>

  <!-- Keywords -->
  <div class="flex flex-wrap gap-1.5">
    {keywords.map((keyword) => (
      <span class="text-pixel text-[7px] px-1.5 py-0.5 bg-mocha-surface/50 text-caramel/80 border border-mocha-subtle/30 rounded-sm">
        {keyword}
      </span>
    ))}
  </div>
</div>

<style>
  .research-card {
    position: relative;
  }

  .research-card:hover {
    transform: translateY(-2px);
  }

  .pixel-icon {
    transition: transform 0.2s ease;
  }

  .research-card:hover .pixel-icon {
    transform: rotate(45deg);
  }
</style>
