---
interface Props {
  title: string;
  description: string;
  keywords: string[];
}

const { title, description, keywords } = Astro.props;
---

<div class="group bg-mocha-surface p-6 border-4 border-mocha-subtle hover:border-caramel transition-all duration-200 pixel-hover">
  <!-- Pixel corner decorations -->
  <div class="relative">
    <div class="absolute -top-8 -left-8 w-2 h-2 bg-caramel opacity-0 group-hover:opacity-100 transition-opacity"></div>

    <!-- Title with pixel icon -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-4 h-4 bg-pixel-orange"></div>
      <h3 class="text-base font-semibold text-warm-white font-sans">{title}</h3>
    </div>

    <!-- Description -->
    <p class="text-sm text-cream/80 mb-4 leading-relaxed">{description}</p>

    <!-- Keywords -->
    <div class="flex flex-wrap gap-2">
      {keywords.map(keyword => (
        <span class="text-pixel text-[8px] px-2 py-1 bg-mocha-overlay text-caramel border border-mocha-subtle">
          {keyword}
        </span>
      ))}
    </div>
  </div>
</div>
