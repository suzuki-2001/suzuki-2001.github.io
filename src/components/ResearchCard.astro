---
interface Props {
  title: string;
  description: string;
  keywords: string[];
}

const { title, description, keywords } = Astro.props;
---

<div class="research-card group bg-white p-5 border border-border rounded-lg card-hover">
  <!-- Title -->
  <div class="flex items-center gap-2 mb-2">
    <div class="w-2 h-2 bg-blue rounded-full"></div>
    <h3 class="text-sm font-semibold text-navy">{title}</h3>
  </div>

  <!-- Description -->
  <p class="text-xs text-slate leading-relaxed mb-3">{description}</p>

  <!-- Keywords -->
  <div class="flex flex-wrap gap-1.5">
    {keywords.map((keyword) => (
      <span class="text-[11px] px-2 py-0.5 bg-base-blue text-blue/80 border border-blue/10 rounded-full">
        {keyword}
      </span>
    ))}
  </div>
</div>
