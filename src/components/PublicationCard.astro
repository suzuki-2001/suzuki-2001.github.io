---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: string;
  link?: string;
  type?: 'paper' | 'preprint' | 'workshop';
}

const { title, authors, venue, year, link, type = 'paper' } = Astro.props;

const typeColors = {
  paper: 'bg-pixel-green/20 text-pixel-green',
  preprint: 'bg-pixel-orange/20 text-pixel-orange',
  workshop: 'bg-caramel/20 text-caramel'
};

const typeLabels = {
  paper: 'PAPER',
  preprint: 'PREPRINT',
  workshop: 'WORKSHOP'
};
---

<article class="pub-card group bg-mocha-surface/30 border border-mocha-subtle/30 rounded-sm p-4 card-hover">
  <!-- Type badge and year -->
  <div class="flex items-center gap-2 mb-2">
    <span class={`text-pixel text-[7px] px-1.5 py-0.5 rounded-sm ${typeColors[type]}`}>
      {typeLabels[type]}
    </span>
    <span class="text-pixel text-[9px] text-mocha-subtle">{year}</span>
  </div>

  <!-- Title -->
  {link ? (
    <a href={link} target="_blank" rel="noopener noreferrer" class="block">
      <h3 class="text-sm font-medium text-warm-white group-hover:text-caramel transition-colors mb-1.5 leading-tight">
        {title}
      </h3>
    </a>
  ) : (
    <h3 class="text-sm font-medium text-warm-white mb-1.5 leading-tight">
      {title}
    </h3>
  )}

  <!-- Authors -->
  <p class="text-xs text-cream/60 mb-1">{authors}</p>

  <!-- Venue -->
  <p class="text-xs text-caramel/80 italic">{venue}</p>
</article>

<style>
  .pub-card {
    position: relative;
  }

  .pub-card:hover {
    transform: translateX(2px);
  }
</style>
