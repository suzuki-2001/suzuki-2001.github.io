---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: string;
  link?: string;
  type?: 'paper' | 'preprint' | 'workshop';
}

const { title, authors, venue, year, link, type = 'paper' } = Astro.props;

const typeColors = {
  paper: 'bg-blue/10 text-blue',
  preprint: 'bg-gold/15 text-gold',
  workshop: 'bg-sky/10 text-sky'
};

const typeLabels = {
  paper: 'PAPER',
  preprint: 'PREPRINT',
  workshop: 'WORKSHOP'
};
---

<article class="pub-card group bg-white border border-border rounded-lg p-5 card-hover">
  <!-- Type badge and year -->
  <div class="flex items-center gap-2 mb-2">
    <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${typeColors[type]}`}>
      {typeLabels[type]}
    </span>
    <span class="text-xs text-slate-light">{year}</span>
  </div>

  <!-- Title -->
  {link ? (
    <a href={link} target="_blank" rel="noopener noreferrer" class="block">
      <h3 class="text-sm font-medium text-navy group-hover:text-blue transition-colors mb-1.5 leading-snug">
        {title}
      </h3>
    </a>
  ) : (
    <h3 class="text-sm font-medium text-navy mb-1.5 leading-snug">
      {title}
    </h3>
  )}

  <!-- Authors -->
  <p class="text-xs text-slate mb-1">{authors}</p>

  <!-- Venue -->
  <p class="text-xs text-blue/70 italic">{venue}</p>
</article>
