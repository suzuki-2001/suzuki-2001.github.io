---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<h2 id={id} class="section-title text-lg md:text-xl font-semibold text-navy mb-8 inline-block scroll-mt-24">
  <slot />
  <div class="title-underline"></div>
</h2>

<style>
  .section-title {
    position: relative;
  }

  .title-underline {
    margin-top: 6px;
    height: 3px;
    width: 100%;
    background: linear-gradient(90deg, var(--color-blue), var(--color-sky));
    border-radius: 2px;
  }
</style>
