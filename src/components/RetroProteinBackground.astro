---
// Retro Protein Background with 3Dmol.js
// All structures ~50-80 residues/nt for visual consistency
// No zoom adjustment — just zoomTo() and render
const base = import.meta.env.BASE_URL;

const structures = [
  // Proteins
  { pdbId: '1UBQ', name: 'Ubiquitin' },
  { pdbId: '1ENH', name: 'Homeodomain' },
  { pdbId: '2CI2', name: 'CI2' },
  { pdbId: '9T8Z', name: 'Protein' },
  { pdbId: '9LVU', name: 'Protein' },
  { pdbId: '9LOM', name: 'Protein' },
  { pdbId: '9QT0', name: 'Protein' },
  { pdbId: '9LNS', name: 'Protein' },
  // DNA
  { pdbId: '8FHV', name: 'DNA' },
  { pdbId: '8FHX', name: 'DNA' },
  { pdbId: '8FHZ', name: 'DNA' },
  // RNA
  { pdbId: '1EHZ', name: 'tRNA' },
  { pdbId: '1EVV', name: 'tRNA' },
  { pdbId: '1TRA', name: 'tRNA' },
  { pdbId: '4TNA', name: 'tRNA' },
  { pdbId: '1Y26', name: 'RNA' },
];

// 3 rows — each row mixes protein + DNA + RNA
const rows = [
  [structures[0], structures[8],  structures[11], structures[3], structures[10], structures[13]],
  [structures[12], structures[1], structures[9],  structures[4], structures[15], structures[6]],
  [structures[2],  structures[14], structures[5], structures[8], structures[7],  structures[11]],
];
---

<div class="retro-protein-bg" aria-hidden="true" data-base={base} style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; z-index: 0; opacity: 0.28;">
  <div id="protein-loading" class="loading-indicator">
    <div class="loading-dots"><span></span><span></span><span></span></div>
  </div>
  {rows.map((rowItems, rowIndex) => (
    <div
      class={`protein-row ${rowIndex % 2 === 0 ? 'scroll-left' : 'scroll-right'}`}
      style={`position: absolute; left: 0; top: ${rowIndex * 30 + 3}vh; display: flex; gap: 2rem; align-items: center;`}
    >
      {[...rowItems, ...rowItems, ...rowItems].map((item, i) => (
        <div class="protein-cell" data-pdb-id={item.pdbId} data-index={`${rowIndex}-${i}`}>
          <canvas class="protein-canvas"></canvas>
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .loading-indicator {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10; transition: opacity 0.5s ease;
  }
  .loading-indicator.hidden { opacity: 0; pointer-events: none; }
  .loading-dots { display: flex; gap: 6px; }
  .loading-dots span {
    width: 6px; height: 6px; background: #0064e0;
    border-radius: 50%; animation: loadingPulse 1s ease-in-out infinite;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes loadingPulse {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1); }
  }
  .scroll-left { animation: scrollLeft 120s linear infinite; }
  .scroll-right { animation: scrollRight 110s linear infinite; }
  @keyframes scrollLeft {
    0% { transform: translateX(-33%); }
    100% { transform: translateX(0%); }
  }
  @keyframes scrollRight {
    0% { transform: translateX(-33%); }
    100% { transform: translateX(0%); }
  }
  .protein-cell { width: 180px; height: 180px; flex-shrink: 0; }
  .protein-canvas {
    width: 100%; height: 100%;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-left, .scroll-right { animation: none; }
  }
</style>

<script>
  const PALETTES = {
    blues: (t: number) => `rgb(${Math.round(219-t*219)},${Math.round(234-t*134)},${Math.round(254-t*30)})`,
    skies: (t: number) => `rgb(${Math.round(224-t*210)},${Math.round(242-t*77)},${Math.round(254-t*21)})`,
    golds: (t: number) => `rgb(${Math.round(254-t*58)},${Math.round(243-t*88)},${Math.round(199-t*149)})`,
    teals: (t: number) => `rgb(${Math.round(204-t*191)},${Math.round(241-t*93)},${Math.round(245-t*109)})`,
    indigos: (t: number) => `rgb(${Math.round(224-t*145)},${Math.round(222-t*152)},${Math.round(254-t*25)})`,
    greens: (t: number) => `rgb(${Math.round(220-t*198)},${Math.round(242-t*79)},${Math.round(222-t*148)})`,
    roses: (t: number) => `rgb(${Math.round(254-t*29)},${Math.round(226-t*197)},${Math.round(226-t*154)})`,
  };

  const BG_COLOR = { r: 240, g: 247, b: 255 };
  const NUCLEIC_PDBS = new Set(['8FHV','8FHX','8FHZ','1EHZ','1EVV','1TRA','4TNA','1Y26']);

  declare global { interface Window { $3Dmol: any; } }

  class RetroProteinRenderer {
    private hiddenContainer: HTMLDivElement;
    private viewers: Map<string, { viewer: any; targetCanvases: HTMLCanvasElement[] }> = new Map();
    private animationId: number | null = null;
    private basePath: string;

    constructor() {
      this.hiddenContainer = document.createElement('div');
      this.hiddenContainer.style.cssText = 'position:absolute;left:-9999px;top:-9999px;visibility:hidden;';
      document.body.appendChild(this.hiddenContainer);
      const bgEl = document.querySelector('.retro-protein-bg') as HTMLElement;
      this.basePath = bgEl?.dataset.base || '';
    }

    async init() {
      await this.loadScript();
      const cells = document.querySelectorAll('.protein-cell');
      const cellsByPdb: Map<string, HTMLCanvasElement[]> = new Map();
      for (const cell of cells) {
        const pdbId = cell.getAttribute('data-pdb-id');
        const canvas = cell.querySelector('.protein-canvas') as HTMLCanvasElement;
        if (!pdbId || !canvas) continue;
        if (!cellsByPdb.has(pdbId)) cellsByPdb.set(pdbId, []);
        cellsByPdb.get(pdbId)!.push(canvas);
      }
      const entries = Array.from(cellsByPdb.entries());
      const pdbDataMap = new Map<string, string>();
      await Promise.all(entries.map(async ([pdbId]) => {
        try { pdbDataMap.set(pdbId, await this.fetchPDB(pdbId)); }
        catch (err) { console.error(`[Protein] Failed: ${pdbId}`, err); }
      }));
      let pi = 0;
      for (const [pdbId, canvases] of entries) {
        const d = pdbDataMap.get(pdbId);
        if (!d) continue;
        try { await this.createViewer(pdbId, d, canvases, pi++); }
        catch (err) { console.error(`[Protein] Failed: ${pdbId}`, err); }
      }
      const el = document.getElementById('protein-loading');
      if (el) el.classList.add('hidden');
      this.animate();
    }

    private loadScript(): Promise<void> {
      return new Promise((resolve, reject) => {
        if (window.$3Dmol) { resolve(); return; }
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/3Dmol/2.0.3/3Dmol-min.js';
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed to load 3Dmol'));
        document.head.appendChild(s);
      });
    }

    private async fetchPDB(id: string): Promise<string> {
      const r = await fetch(`${this.basePath}pdb/${id}.pdb`);
      if (!r.ok) throw new Error(`PDB fetch failed: ${id}`);
      return r.text();
    }

    private async createViewer(pdbId: string, pdbData: string, targetCanvases: HTMLCanvasElement[], paletteIndex: number) {
      const div = document.createElement('div');
      div.style.width = '180px';
      div.style.height = '180px';
      this.hiddenContainer.appendChild(div);

      const viewer = window.$3Dmol.createViewer(div, { backgroundColor: '#f0f7ff', antialias: true });
      viewer.addModel(pdbData, 'pdb');

      const keys = Object.keys(PALETTES) as (keyof typeof PALETTES)[];
      const palette = PALETTES[keys[paletteIndex % keys.length]];
      const colorfunc = (atom: any) => {
        const all = viewer.selectedAtoms({});
        const chain = all.filter((a: any) => a.chain === atom.chain);
        const mn = Math.min(...chain.map((a: any) => a.resi));
        const mx = Math.max(...chain.map((a: any) => a.resi));
        return palette((atom.resi - mn) / (mx - mn || 1));
      };

      if (NUCLEIC_PDBS.has(pdbId)) {
        viewer.setStyle({}, { cartoon: { colorfunc }, stick: { radius: 0.12, colorfunc } });
      } else {
        viewer.setStyle({}, { cartoon: { colorfunc } });
      }

      // Simple zoomTo — no manual zoom override
      viewer.zoomTo();
      viewer.rotate(Math.random() * 360, 'y');
      viewer.rotate(Math.random() * 30 - 15, 'x');
      viewer.render();

      for (const c of targetCanvases) { c.width = 180; c.height = 180; }
      this.viewers.set(pdbId, { viewer, targetCanvases });
    }

    private isBackground(r: number, g: number, b: number): boolean {
      return Math.abs(r - BG_COLOR.r) < 25 && Math.abs(g - BG_COLOR.g) < 25 && Math.abs(b - BG_COLOR.b) < 25;
    }

    private pixelate(src: HTMLCanvasElement, dst: HTMLCanvasElement) {
      const ctx = dst.getContext('2d');
      if (!ctx || src.width === 0) return;
      const w = dst.width, h = dst.height, ps = 2;
      const pw = Math.ceil(w / ps), ph = Math.ceil(h / ps);
      const tmp = document.createElement('canvas');
      tmp.width = pw; tmp.height = ph;
      const tc = tmp.getContext('2d');
      if (!tc) return;
      tc.imageSmoothingEnabled = false;
      tc.drawImage(src, 0, 0, pw, ph);
      const img = tc.getImageData(0, 0, pw, ph);
      const d = img.data, out = new Uint8ClampedArray(d);
      for (let y = 0; y < ph; y++) for (let x = 0; x < pw; x++) {
        const i = (y * pw + x) * 4;
        if (this.isBackground(d[i], d[i+1], d[i+2])) out[i+3] = 0;
      }
      for (let y = 0; y < ph; y++) for (let x = 0; x < pw; x++) {
        const i = (y * pw + x) * 4;
        if (!this.isBackground(d[i], d[i+1], d[i+2])) {
          for (const [dx, dy] of [[-1,0],[1,0],[0,-1],[0,1]]) {
            const nx = x+dx, ny = y+dy;
            if (nx >= 0 && nx < pw && ny >= 0 && ny < ph) {
              const ni = (ny * pw + nx) * 4;
              if (this.isBackground(d[ni], d[ni+1], d[ni+2])) {
                out[ni] = 148; out[ni+1] = 163; out[ni+2] = 184; out[ni+3] = 120;
              }
            }
          }
        }
      }
      tc.putImageData(new ImageData(out, pw, ph), 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(tmp, 0, 0, w, h);
    }

    private animate = () => {
      this.viewers.forEach(({ viewer, targetCanvases }) => {
        viewer.rotate(0.3, 'y');
        viewer.render();
        const c = viewer.getCanvas();
        if (c) for (const t of targetCanvases) this.pixelate(c, t);
      });
      this.animationId = requestAnimationFrame(this.animate);
    };

    dispose() {
      if (this.animationId) cancelAnimationFrame(this.animationId);
      this.hiddenContainer.remove();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new RetroProteinRenderer().init().catch(console.error);
  });
</script>
