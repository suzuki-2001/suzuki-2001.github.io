---
// 3D Protein Viewer with Pixel Art Effect
// Uses Three.js with low-resolution rendering for retro aesthetic
// Features: GFP (Green Fluorescent Protein), DNA helix, and other structures
---

<div class="protein-viewer-container" aria-hidden="true">
  <canvas id="protein-canvas"></canvas>

  <!-- Pixel overlay for extra retro feel -->
  <div class="scanlines"></div>
</div>

<style>
  .protein-viewer-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  #protein-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
    pointer-events: none;
  }
</style>

<script>
  import * as THREE from 'three';

  // Mocha color palette
  const COLORS = {
    base: 0x1e1e2e,
    caramel: 0xf9e2af,
    orange: 0xfab387,
    green: 0xa6e3a1,
    neonGreen: 0x39ff14,
    cream: 0xcdd6f4,
    surface: 0x313244,
  };

  // Pixel resolution (lower = more pixelated)
  const PIXEL_SCALE = 3; // Render at 1/3 resolution for clearer shapes

  class PixelProteinViewer {
    private scene: THREE.Scene;
    private camera: THREE.PerspectiveCamera;
    private renderer: THREE.WebGLRenderer;
    private proteins: THREE.Group[] = [];
    private renderTarget: THREE.WebGLRenderTarget;
    private finalScene: THREE.Scene;
    private finalCamera: THREE.OrthographicCamera;
    private finalQuad: THREE.Mesh;
    private time: number = 0;
    private animationId: number | null = null;

    constructor(canvas: HTMLCanvasElement) {
      // Main scene
      this.scene = new THREE.Scene();

      // Camera
      this.camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
      this.camera.position.z = 10;

      // Renderer
      this.renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: false
      });
      this.renderer.setPixelRatio(1);
      this.renderer.setClearColor(0x000000, 0);

      // Low-res render target for pixelation
      const width = Math.floor(window.innerWidth / PIXEL_SCALE);
      const height = Math.floor(window.innerHeight / PIXEL_SCALE);
      this.renderTarget = new THREE.WebGLRenderTarget(width, height, {
        minFilter: THREE.NearestFilter,
        magFilter: THREE.NearestFilter,
        format: THREE.RGBAFormat
      });

      // Final scene for upscaling
      this.finalScene = new THREE.Scene();
      this.finalCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

      const finalGeometry = new THREE.PlaneGeometry(2, 2);
      const finalMaterial = new THREE.MeshBasicMaterial({
        map: this.renderTarget.texture,
        transparent: true
      });
      this.finalQuad = new THREE.Mesh(finalGeometry, finalMaterial);
      this.finalScene.add(this.finalQuad);

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
      this.scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
      directionalLight.position.set(5, 5, 5);
      this.scene.add(directionalLight);

      const backLight = new THREE.DirectionalLight(0x39ff14, 0.3);
      backLight.position.set(-3, -3, -3);
      this.scene.add(backLight);

      // Create proteins
      this.createProteins();

      // Handle resize
      window.addEventListener('resize', () => this.onResize());
      this.onResize();

      // Start animation
      this.animate();
    }

    private createProteins() {
      // GFP - barrel with shear angle for mesh appearance
      const gfp = this.createGFP();
      gfp.position.set(-3.4, 2.0, -1);
      gfp.scale.setScalar(0.55);
      gfp.userData.basePosition = gfp.position.clone();
      gfp.userData.rotationSpeed = 0.25;
      gfp.userData.floatSpeed = 0.4;
      gfp.userData.floatPhase = 0;
      this.scene.add(gfp);
      this.proteins.push(gfp);

      // DNA double helix
      const dna = this.createDNAHelix();
      dna.position.set(4, -1.5, -2);
      dna.scale.setScalar(0.7);
      dna.userData.basePosition = dna.position.clone();
      dna.userData.rotationSpeed = 0.2;
      dna.userData.floatSpeed = 0.5;
      dna.userData.floatPhase = Math.PI;
      this.scene.add(dna);
      this.proteins.push(dna);

      // Small protein
      const small = this.createSmallProtein();
      small.position.set(3.5, 2.5, -2);
      small.scale.setScalar(0.4);
      small.userData.basePosition = small.position.clone();
      small.userData.rotationSpeed = 0.35;
      small.userData.floatSpeed = 0.7;
      small.userData.floatPhase = Math.PI * 1.5;
      this.scene.add(small);
      this.proteins.push(small);

      // Another small protein on the left bottom
      const small2 = this.createSmallProtein();
      small2.position.set(-3.5, -2, -2.5);
      small2.scale.setScalar(0.35);
      small2.userData.basePosition = small2.position.clone();
      small2.userData.rotationSpeed = 0.3;
      small2.userData.floatSpeed = 0.55;
      small2.userData.floatPhase = Math.PI * 0.5;
      this.scene.add(small2);
      this.proteins.push(small2);
    }

    private createGFP(): THREE.Group {
      const group = new THREE.Group();

      // GFP β-barrel parameters based on actual structure
      // The barrel has 11 strands with a characteristic shear angle
      const strandCount = 11;
      const barrelRadius = 1.25;
      const barrelHeight = 2.9;  // Taller barrel
      const shearAngle = 32 * (Math.PI / 180);  // Adjusted shear for better look

      // Materials - more transparent for seeing inside
      const betaSheetMaterial = new THREE.MeshStandardMaterial({
        color: 0x9de8b8,  // Very pale green
        roughness: 0.4,
        metalness: 0.0,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.65
      });

      const helixMaterial = new THREE.MeshStandardMaterial({
        color: 0xf5b8a8,  // Very pale coral
        roughness: 0.35,
        metalness: 0.0,
        transparent: true,
        opacity: 0.7
      });

      const loopMaterial = new THREE.MeshStandardMaterial({
        color: 0xc8d0dc,  // Very pale gray
        roughness: 0.5,
        metalness: 0.0,
        transparent: true,
        opacity: 0.55
      });

      // Ribbon dimensions - slightly wider for visibility
      const ribbonWidth = 0.3;
      const ribbonThickness = 0.09;

      // Store strand endpoints for loop connections
      const strandTops: THREE.Vector3[] = [];
      const strandBottoms: THREE.Vector3[] = [];

      // Create 11 β-strands with shear (tilted/twisted strands)
      for (let i = 0; i < strandCount; i++) {
        const baseAngle = (i / strandCount) * Math.PI * 2;

        // Each strand is tilted - top and bottom are at different angular positions
        // This creates the characteristic "mesh" appearance of GFP
        const topAngle = baseAngle - shearAngle / 2;
        const bottomAngle = baseAngle + shearAngle / 2;

        // Build strand path with shear
        const pathPoints: THREE.Vector3[] = [];
        const segments = 12;

        for (let j = 0; j <= segments; j++) {
          const t = j / segments;
          const y = (t - 0.5) * barrelHeight * 0.8;

          // Interpolate angle from top to bottom (creates the shear/tilt)
          const angle = topAngle + t * (bottomAngle - topAngle);

          // Slight bulge in middle
          const bulge = Math.sin(t * Math.PI) * 0.05;
          const r = barrelRadius + bulge;

          // Also add slight twist within the strand itself
          const twist = Math.sin(t * Math.PI * 2) * 0.03;

          pathPoints.push(new THREE.Vector3(
            Math.cos(angle) * (r + twist),
            y,
            Math.sin(angle) * (r + twist)
          ));
        }

        // Store endpoints
        strandTops.push(pathPoints[0].clone());
        strandBottoms.push(pathPoints[pathPoints.length - 1].clone());

        // Create ribbon path
        const curve = new THREE.CatmullRomCurve3(pathPoints);

        // Create ribbon shape
        const shape = new THREE.Shape();
        shape.moveTo(-ribbonWidth / 2, -ribbonThickness / 2);
        shape.lineTo(ribbonWidth / 2, -ribbonThickness / 2);
        shape.lineTo(ribbonWidth / 2, ribbonThickness / 2);
        shape.lineTo(-ribbonWidth / 2, ribbonThickness / 2);
        shape.closePath();

        // Extrude ribbon
        const ribbonGeom = new THREE.ExtrudeGeometry(shape, {
          steps: segments * 4,
          bevelEnabled: false,
          extrudePath: curve
        });

        group.add(new THREE.Mesh(ribbonGeom, betaSheetMaterial));

        // Arrow head at C-terminus
        const arrowWidth = ribbonWidth * 2.2;
        const arrowLength = 0.2;
        const lastPt = pathPoints[pathPoints.length - 1];
        const prevPt = pathPoints[pathPoints.length - 2];
        const dir = new THREE.Vector3().subVectors(lastPt, prevPt).normalize();

        // Create flat arrow shape
        const arrowShape = new THREE.Shape();
        arrowShape.moveTo(0, arrowLength);
        arrowShape.lineTo(-arrowWidth / 2, 0);
        arrowShape.lineTo(-ribbonWidth / 2, 0);
        arrowShape.lineTo(-ribbonWidth / 2, -0.02);
        arrowShape.lineTo(ribbonWidth / 2, -0.02);
        arrowShape.lineTo(ribbonWidth / 2, 0);
        arrowShape.lineTo(arrowWidth / 2, 0);
        arrowShape.closePath();

        const arrowGeom = new THREE.ExtrudeGeometry(arrowShape, {
          depth: ribbonThickness,
          bevelEnabled: false
        });

        const arrow = new THREE.Mesh(arrowGeom, betaSheetMaterial);
        arrow.position.copy(lastPt);

        // Orient arrow
        const quaternion = new THREE.Quaternion();
        quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir);
        arrow.setRotationFromQuaternion(quaternion);
        arrow.translateY(-arrowLength / 2);

        group.add(arrow);
      }

      // Loop connections between strands
      for (let i = 0; i < strandCount; i++) {
        const nextI = (i + 1) % strandCount;

        // Top loops
        const ts = strandTops[i];
        const te = strandTops[nextI];
        const tmid = new THREE.Vector3(
          (ts.x + te.x) / 2 * 1.15,
          ts.y + 0.18,
          (ts.z + te.z) / 2 * 1.15
        );

        const topCurve = new THREE.QuadraticBezierCurve3(ts, tmid, te);
        const topTube = new THREE.TubeGeometry(topCurve, 8, 0.035, 6, false);
        group.add(new THREE.Mesh(topTube, loopMaterial));

        // Bottom loops (alternating for antiparallel)
        if (i % 2 === 0) {
          const bs = strandBottoms[i];
          const be = strandBottoms[nextI];
          const bmid = new THREE.Vector3(
            (bs.x + be.x) / 2 * 1.1,
            bs.y - 0.15,
            (bs.z + be.z) / 2 * 1.1
          );

          const bottomCurve = new THREE.QuadraticBezierCurve3(bs, bmid, be);
          const bottomTube = new THREE.TubeGeometry(bottomCurve, 8, 0.035, 6, false);
          group.add(new THREE.Mesh(bottomTube, loopMaterial));
        }
      }

      // Central alpha helix
      const helixRadius = 0.22;
      const helixHeight = barrelHeight * 0.6;
      const helixTurns = 2.5;
      const helixPoints: THREE.Vector3[] = [];
      const helixSegs = 50;

      for (let i = 0; i <= helixSegs; i++) {
        const t = i / helixSegs;
        const theta = t * helixTurns * Math.PI * 2;
        const y = (t - 0.5) * helixHeight;
        helixPoints.push(new THREE.Vector3(
          Math.cos(theta) * helixRadius,
          y,
          Math.sin(theta) * helixRadius
        ));
      }

      const helixCurve = new THREE.CatmullRomCurve3(helixPoints);
      const helixTube = new THREE.TubeGeometry(helixCurve, helixSegs, 0.1, 10, false);
      group.add(new THREE.Mesh(helixTube, helixMaterial));

      // Chromophore - bright fluorescent center
      const chromophoreGroup = new THREE.Group();
      chromophoreGroup.userData.isChromophore = true;

      // Core - bright green
      const coreMat = new THREE.MeshBasicMaterial({
        color: 0x00ff44,
        transparent: true,
        opacity: 1.0
      });
      const core = new THREE.Mesh(new THREE.OctahedronGeometry(0.12, 0), coreMat);
      chromophoreGroup.add(core);

      // Inner glow
      const innerGlowMat = new THREE.MeshBasicMaterial({
        color: 0x22ff66,
        transparent: true,
        opacity: 0.7
      });
      const innerGlow = new THREE.Mesh(new THREE.SphereGeometry(0.18, 8, 8), innerGlowMat);
      chromophoreGroup.add(innerGlow);

      // Outer glow
      const outerGlowMat = new THREE.MeshBasicMaterial({
        color: COLORS.neonGreen,
        transparent: true,
        opacity: 0.35
      });
      const outerGlow = new THREE.Mesh(new THREE.SphereGeometry(0.28, 8, 8), outerGlowMat);
      chromophoreGroup.add(outerGlow);

      group.add(chromophoreGroup);

      return group;
    }

    private createDNAHelix(): THREE.Group {
      const group = new THREE.Group();
      const turns = 2;
      const height = 3;
      const radius = 0.5;
      const pointsPerTurn = 12;

      // Create two strands
      for (let strand = 0; strand < 2; strand++) {
        const offset = strand * Math.PI;
        const strandColor = strand === 0 ? COLORS.caramel : COLORS.orange;

        for (let i = 0; i < turns * pointsPerTurn; i++) {
          const t = i / (turns * pointsPerTurn);
          const angle = t * turns * Math.PI * 2 + offset;
          const y = t * height - height / 2;

          // Nucleotide
          const nucleotideGeometry = new THREE.BoxGeometry(0.15, 0.15, 0.15);
          const nucleotideMaterial = new THREE.MeshLambertMaterial({
            color: strandColor,
            transparent: true,
            opacity: 0.8,
            flatShading: true
          });
          const nucleotide = new THREE.Mesh(nucleotideGeometry, nucleotideMaterial);
          nucleotide.position.set(
            Math.cos(angle) * radius,
            y,
            Math.sin(angle) * radius
          );
          group.add(nucleotide);
        }
      }

      // Base pairs connecting strands
      for (let i = 0; i < turns * pointsPerTurn / 2; i++) {
        const t = (i * 2) / (turns * pointsPerTurn);
        const angle = t * turns * Math.PI * 2;
        const y = t * height - height / 2;

        const basePairGeometry = new THREE.BoxGeometry(radius * 1.8, 0.06, 0.06);
        const basePairMaterial = new THREE.MeshLambertMaterial({
          color: COLORS.cream,
          transparent: true,
          opacity: 0.4,
          flatShading: true
        });
        const basePair = new THREE.Mesh(basePairGeometry, basePairMaterial);
        basePair.position.set(0, y, 0);
        basePair.rotation.y = angle;
        group.add(basePair);
      }

      return group;
    }

    private createSmallProtein(): THREE.Group {
      const group = new THREE.Group();

      const positions = [
        [0, 0, 0], [0.3, 0.2, 0.1], [-0.2, 0.3, 0.15],
        [0.1, -0.3, 0.2], [-0.15, -0.15, -0.2], [0.2, 0.1, -0.15]
      ];

      positions.forEach((pos) => {
        const geometry = new THREE.IcosahedronGeometry(0.2 + Math.random() * 0.1, 0);
        const material = new THREE.MeshLambertMaterial({
          color: COLORS.cream,
          transparent: true,
          opacity: 0.6,
          flatShading: true
        });
        const sphere = new THREE.Mesh(geometry, material);
        sphere.position.set(pos[0], pos[1], pos[2]);
        group.add(sphere);
      });

      return group;
    }

    private onResize() {
      const width = window.innerWidth;
      const height = window.innerHeight;

      this.camera.aspect = width / height;
      this.camera.updateProjectionMatrix();

      this.renderer.setSize(width, height);

      const rtWidth = Math.floor(width / PIXEL_SCALE);
      const rtHeight = Math.floor(height / PIXEL_SCALE);
      this.renderTarget.setSize(rtWidth, rtHeight);
    }

    private animate = () => {
      this.animationId = requestAnimationFrame(this.animate);
      this.time += 0.016;

      this.proteins.forEach(protein => {
        // Floating motion
        const floatOffset = Math.sin(this.time * protein.userData.floatSpeed + protein.userData.floatPhase) * 0.4;
        protein.position.y = protein.userData.basePosition.y + floatOffset;

        // Slow rotation
        protein.rotation.y += protein.userData.rotationSpeed * 0.008;
        protein.rotation.x = Math.sin(this.time * 0.2 + protein.userData.floatPhase) * 0.1;

        // Pulse chromophore
        protein.traverse((child: THREE.Object3D) => {
          if (child.userData.isChromophore) {
            const pulseScale = 1 + Math.sin(this.time * 2.5) * 0.15;
            child.scale.setScalar(pulseScale);

            // Also pulse opacity of children
            child.children.forEach((glowPart: THREE.Object3D) => {
              if (glowPart instanceof THREE.Mesh && glowPart.material instanceof THREE.MeshBasicMaterial) {
                const baseOpacity = glowPart.geometry.parameters?.radius > 0.4 ? 0.25 :
                                   glowPart.geometry.parameters?.radius > 0.3 ? 0.6 : 1.0;
                glowPart.material.opacity = baseOpacity * (0.8 + Math.sin(this.time * 3) * 0.2);
              }
            });
          }
        });
      });

      // Render to low-res target
      this.renderer.setRenderTarget(this.renderTarget);
      this.renderer.render(this.scene, this.camera);

      // Render upscaled to screen
      this.renderer.setRenderTarget(null);
      this.renderer.render(this.finalScene, this.finalCamera);
    }

    public dispose() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      this.renderTarget.dispose();
      this.renderer.dispose();
    }
  }

  // Initialize on load
  const canvas = document.getElementById('protein-canvas') as HTMLCanvasElement;
  if (canvas) {
    new PixelProteinViewer(canvas);
  }
</script>
